{
  "name": "agent-latency-lab",
  "version": "1.0.0",
  "description": "Interactive AI agent latency analyzer: trace waterfall, Monte Carlo percentiles, SLO budgets, and what-if optimizations — plus Express instrumentation middleware.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/demo-server.ts",
    "typecheck": "tsc --noEmit && esbuild src/main.tsx --loader:.tsx=tsx --loader:.jsx=jsx --bundle --external:react --external:react-dom --outfile=/dev/null",
    "test": "vitest run",
    "test:unit": "vitest run tests/latency-trace.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
